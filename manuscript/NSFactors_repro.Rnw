<<setup,echo=FALSE,message=FALSE,warning=FALSE,cache=FALSE>>=
    library(xtable)
    library(kableExtra)
    opts_chunk$set(fig.dim=c(4.5,4.5), out.width="0.4\\linewidth", size='small', echo=FALSE, message=FALSE, dev='tikz', fig.align="center", cache=TRUE,background="#F7F7F7", comment=NA, fig.show='hold', cache.path='cache/', fig.path='figures/',crop=TRUE,out.extra='keepaspectratio')
    options(continue='   ', width=100, digits=7)
    opts_knit$set(use.highlight=TRUE, concordance = TRUE)
    knit_hooks$set(crop = hook_pdfcrop)
    options(tikzDefaultEngine = 'luatex')
@
<<settings>>=
 lwd.acf <- 6
 col.acf <- 'red4'
 ## Custom colours

rval   <- col2rgb('blue')
bluet  <- rgb(red=rval[1], green=rval[2], blue=rval[3], alpha=100, names = "bluet",
maxColorValue = 255)

rval   <- col2rgb('lightblue')
lbluet <- rgb(red=rval[1], green=rval[2], blue=rval[3], alpha=120, names = "lbluet",
maxColorValue = 255)
@
<<helpers>>=

## -----------------------------------------
subtab_labels <- list(
  "1" = "$\\widetilde{\\R}_0$",
  "2" = "$\\widetilde{\\C}_0$",
  "5" = "$\\widetilde{\\R}_1$",
  "6" = "$\\widetilde{\\C}_1$",
  "7" = "$\\proj \\R_1$",
  "8" = "$\\proj \\C_1$"
)
## -----------------------------------------
make_subtable <- function(x, j, i){

  dum <- x[j,,,i] / x[j,,,i+2]
  dum <- as.data.frame(dum)

  tab <- data.frame(
    T = nset,
    dum,
    check.names = FALSE
  )

  names(tab) <- c("$T$", p1set)

  out <- kbl(
    tab,
    format = "latex",
    booktabs = TRUE,
    escape = FALSE,
    row.names = FALSE,
    digits = 2,
    align = c("c", rep("c", length(p1set)))
  ) |>
    add_header_above(
      c(" " = 1, "$p_1$" = length(p1set)),
      escape = FALSE,
      line = TRUE,
      line_sep = 0
    )

  out <- as.character(out)

  ## remove only the unwanted upper full rule
  out <- sub("\\\\toprule\n", "", out)

  ## make the body rules match the cmidrule style
  out <- sub("\\\\midrule", "\\\\cmidrule(lr){2-5}", out)
  out <- sub("\\\\bottomrule", "\\\\cmidrule(lr){2-5}", out)

  out
}
## -----------------------------------------
make_cell <- function(x, j, i){
  paste0(
    "\\begin{minipage}[t]{\\linewidth}\n",
    "\\centering\n",
    "\\makebox[\\linewidth][c]{\\textbf{",
    subtab_labels[[as.character(i)]],
    "}}\\par\\smallskip\n",
    make_subtable(x, j, i),
    "\n\\end{minipage}"
  )
}
@
\maketitle

