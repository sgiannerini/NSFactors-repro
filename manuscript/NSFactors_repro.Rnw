%%%%  ***************************************************************************************************
\subsection{Figure B.3}
%%%%  ***************************************************************************************************



\begin{center}
<<Figure B.3, fig.dim=c(10,6),out.width='0.99\\linewidth'>>=
load('Section_B3.RData');
hnames2 <- c('$h_{R_0}$','$h_{C_0}$','$h_{R_1}$','$h_{C_1}$')
a <- min(percs)
par(mfrow=c(4,lp1set),omi=c(0.5,0.5,0.5,0),mai=c(0,0,0,0))
for(j in 1:4){
    for(k in 1:lp1set){
      p1 <- p1set[k]
     dum <- t(percs[k,j,,])
    boxplot(dum, ylab='', ylim=c(a,100),col='lightyellow',xaxt='n',yaxt='n')
    abline(h=0,col=2,lty=2);grid()
    if(k == 1)  axis(2)
    if(j == 4)  axis(1,at=1:lnset,labels=nset,cex.lab=1.2)
    if(k == 1)  mtext(text=hnames2[j], side=2, at=60, line=2.5, cex=1.2)
    if(j == 1)  mtext(text=paste0('$p_1 =$ ',p1), side=3, at=2.5, line=1, cex=1.2)
  }
}
mtext(text='$T$',side=1,at=-4,line=2.5)
@
\end{center}

