%%%  ***************************************************************************************************
%%%  ***************************************************************************************************
\section{Section 5 and Section C of the Supplement}
%%%  ***************************************************************************************************
%%%  ***************************************************************************************************

<<oecd_0>>=
inv.method <- 'qr'   # matrix inversion method
tol        <- 1e-17  # tolerance for matrix inversion

pnames2 <- c('$\\hat\\R_0$', '$\\hat\\C_0$', '$\\tilde\\R_0$', '$\\tilde\\C_0$', '$\\hat\\R_1$', '$\\hatC_1$', '$\\tilde\\R_1$', '$\\tilde\\C_1$', '$\\proj\\R_1$', '$\\proj\\C_1$')
## ****************************************************************************
## PREPROCESSING

dat <- read.csv("../data/OECDdata.csv",stringsAsFactors=TRUE)

country  <- levels(dat$LOCATION)
subject  <- levels(dat$SUBJECT)
TIME     <- levels(dat$TIME)
p1 <- length(country)
p2 <- length(subject)

tabt  <- table(dat$TIME)
tgood <- TIME[(tabt==p1*p2)]  # selects times common to all the series  
tgood <- tgood[29:100] # starts from the introduction of EURO
n  <- length(tgood)

X <- array(0,c(p1,p2,n),dimnames=list(country,subject,tgood))

for(i in 1:p1){ # rows/countries
  for(j in 1:p2){ # columns/indicators
    ind <- (dat[,1]==country[i] & dat[,2]==subject[j]) 
    dum <- dat[ind,3:4]
    ig  <- dum[,1] %in% tgood
    X[i,j, ] <- dum[ig,2]
    if(!(j %in% c(4:5)))  X[i,j, ] <- log(X[i,j, ]) 
    if(j %in% c(1:6))  X[i,j, ] <- residuals(lm(X[i,j, ] ~ I(1:n))) 
  }
}
vX <- apply(X,MARGIN=c(1,2),FUN=var)
sX <- apply(X,MARGIN=c(1,2),FUN=function(x){sum((x-mean(x))^2)})

## *****************************************************************

Xold <- X
X    <- Xold[c(-5,-9,-10,-14),c(-3,-4,-6),]
country_name <- country[c(-5,-9,-10,-14)]
subject_name <- subject[c(-3,-4,-6)]


dx <- dim(X) 
p1 <- dx[1]  # rows of X
p2 <- dx[2]  # columns of X
n  <- dx[3]  # sample size

@

%%-----------------------------------------------------------------------
\subsection{Figure 5.1}
%%-----------------------------------------------------------------------
<<Model, warning=FALSE, results='hide'>>=
## Estimated Factors --------------------------------------------------------
source('../code/Factors_V16.R')
res <- FactEst2(X,2,2,2,1,inv.method=inv.method,tol=tol, fix.refined=FALSE)
hr.1 <- res$hest$p1['hr1p'];
hc.1 <- res$hest$p1['hc1p'] 
hr.0 <- res$hest$p1['hr0p'] 
hc.0 <- res$hest$p1['hc0p'];
@

\begin{center}
<<Figure 5.1,fig.dim=c(4,4),out.width='0.4\\linewidth', dependson='Model'>>=
plot(res$eigMR1p,type='b',lty=2,col=4,pch=16,ylab="Eigenvalue");grid()
 legend('topright',legend=pnames2[7],adj=0.5)
plot(res$eigMC1p,type='b',lty=2,col=4,pch=16,ylab="Eigenvalue");grid()
 legend('topright',legend=pnames2[8],adj=0.5)
plot(res$eigMR0p,type='b',lty=2,col=4,pch=16,ylab="Eigenvalue");grid()
  legend('topright',legend=pnames2[3],adj=0.5)
plot(res$eigMC0p,type='b',lty=2,col=4,pch=16,ylab="Eigenvalue");grid()
  legend('topright',legend=pnames2[4],adj=0.5)
@
\end{center}

%%-----------------------------------------------------------------------
\subsection{Figure 5.2}
%%-----------------------------------------------------------------------
\begin{center}
<<Figure 5.2,fig.dim=c(5,5),out.width='0.5\\linewidth', dependson='Model'>>=
ix <- seq(2002,2020,by=5)
par(mfrow=c(hr.1,hc.1), mai=0.02*c(1,1,1,1),omi=c(0.3,0.1,0.,0))
for(i in 1:hr.1){
  for(j in 1:hc.1){
    dum <- ts(c(res$F1phat[i,j,]),start=c(2002,1),end=c(2019,4),frequency=4)
    plot.ts(dum,col=4,xaxt='n',yaxt='n');grid(nx=0,ny=3)
    abline(v=ix,col = "lightgray", lty = "dotted")
    if(i == hr.1) axis(1,at=ix,labels=paste(ix,'Q1',sep=':'))
  }
}
@
\end{center}


