<<Table A.1, results='asis'>>=
 load('Table_A1.RData')
for(i in 1:3){
for(k in 1:2){
  dum <- perci[,k,,i]
  dum <- as.data.frame(dum)

  tab <- data.frame(
    T = nset,
    dum,
    check.names = FALSE
  )

  names(tab) <- c("$T$", p1set)
hspan <- 5
names(hspan) <- paste0('Case ',i,' -- ',hnames2[k]) 
  out <- kbl(
    tab,
    format = "latex",
    booktabs = TRUE,
    escape = FALSE,
    row.names = FALSE,
    digits = 2,
    align = c("c", rep("c", length(p1set)))
  ) |>
    add_header_above(
      c(" " = 1, "$p_1$" = length(p1set)),
      escape = FALSE,
      line = TRUE,
      line_sep = 0
    ) |>
    add_header_above(
    header=hspan,
      escape = FALSE,
      line = FALSE,
      line_sep = 0,
      align='l'
    )
  cat(out)
}
cat('\\bigskip\n')
}
@
\end{center}
