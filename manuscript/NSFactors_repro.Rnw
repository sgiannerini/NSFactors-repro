    if(k == 1)  mtext(text=hnames2[j], side=2, at=60, line=2.5, cex=1.2)
    if(j == 1)  mtext(text=paste0('$p_1 =$ ',p1), side=3, at=2.5, line=1, cex=1.2)
  }
}
mtext(text='$T$',side=1,at=-4,line=2.5)
