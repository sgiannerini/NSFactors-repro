%%%%  ***************************************************************************************************
\subsection{Table A.3}
%%%%  ***************************************************************************************************


\begin{center}
<<Table A.3, results='asis'>>=
load('Table_A3.RData')

for(i in 1:laset){
  for(k in 3:4){
    dum <- perci1[, k, , i, drop = FALSE]
    dum <- matrix(dum, nrow = lp1set, ncol = lnset,
                  dimnames = list(p1set, nset))
    dum <- as.data.frame(dum, check.names = FALSE)

    tab <- data.frame(
      "$p_1$" = p1set,
      dum,
      check.names = FALSE
    )

    colnames(tab) <- c("$p_1$", as.character(nset))

    hspan <- lnset + 1
    names(hspan) <- paste0("$\\\\alpha =$ ", alphaset[i], " -- ", hnames2[k])

    out <- kbl(
      tab,
      format = "latex",
      booktabs = TRUE,
      escape = FALSE,
      row.names = FALSE,
      digits = 2,
      align = c("c", rep("c", lnset))
    ) |>
      add_header_above(
        c(" " = 1, "$T$" = lnset),
        escape = FALSE,
        line = TRUE,
        line_sep = 0
      ) |>
      add_header_above(
        header = hspan,
        escape = FALSE,
        line = FALSE,
        line_sep = 0,
        align = "l"
      )

    cat(out)
 #   cat("\n")
  }
  cat("\\bigskip\n")
}
@
\end{center}

