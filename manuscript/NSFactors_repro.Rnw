%% ----------------------------------------------------------------------------
\subsection{Tables~B.1--B.8 of the Supplement}
%% ----------------------------------------------------------------------------
\phantom{.}\\
<<Tables B.1-B.8, results='asis', echo=FALSE, message=FALSE, warning=FALSE, dependson='Section 5'>>=

## first row: R-tables
iset_R <- c(1, 5, 7)

## second row: C-tables
iset_C <- c(2, 6, 8)


for(j in 1:lpset){
  cat("-----------------\n")
  cat("\\smallskip \n\n")
  cat("TABLE B.",j,"\n\n\n",sep='')
  cat("-----------------\n")
  cat("\\begin{table}[H]\n")
  cat("\\centering\n")

  cat("\\begin{tabular}{@{}p{0.30\\textwidth}@{\\hspace{0.04\\textwidth}}p{0.30\\textwidth}@{\\hspace{0.04\\textwidth}}p{0.30\\textwidth}@{}}\n")

  cat(make_cell(mcRES, j, iset_R[1]))
  cat(" & ")
  cat(make_cell(mcRES, j, iset_R[2]))
  cat(" & ")
  cat(make_cell(mcRES, j, iset_R[3]))
cat(" \\\\\n")
cat("\\noalign{\\vskip 2em}\n")

  cat(make_cell(mcRES, j, iset_C[1]))
  cat(" & ")
  cat(make_cell(mcRES, j, iset_C[2]))
  cat(" & ")
  cat(make_cell(mcRES, j, iset_C[3]))
  cat(" \n")

  cat("\\end{tabular}\n")

  cat("\\end{table}\n")
  if(j %in% c(2,4,6)) cat("\\newpage\n")
}
@



