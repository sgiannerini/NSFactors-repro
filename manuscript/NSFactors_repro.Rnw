\section{Section 5 and Section B.1 of the Supplement}
%%%  ***************************************************************************************************
%%%  ***************************************************************************************************
<<Section 5>>=
 load('Section_5_B1.RData')
ppnames <- c('R0p','C0p','R1p','C1p','R1p2','C1p2')
casenames <- paste('case',rep(1:4,each=2),rep(1:2,2),sep='.') 
rRES <- array(NA_real_,dim=c(lnset,lp1set,length(ppnames)))
dimnames(rRES)  <- list(nset,p1set,ppnames)
 k <- 1
 for(i in c(1,2,5:8)){
  dum <- mRES[,,i]/mRES[,,i+2]
  rRES[,,k] <- dum
  k <- k+1
}
pnames2 <- c('$\\hat\\R_0$','$\\hat\\C_0$','$\\tilde\\R_0$','$\\tilde\\C_0$','$\\hat\\R_1$','$\\hatC_1$','$\\tilde\\R_1$','$\\tilde\\C_1$','$\\proj\\R_1$','$\\proj\\C_1$')
@


%%-----------------------------------------------------------------------
\subsection{Figure 4.1}
%%-----------------------------------------------------------------------


\begin{center}
<<Figure 4.1, dependson='Section 5'>>=
for(i in c(5,6)){ 
  dum <- mRES[,,i]/mRES[,,i+2];
  a   <- min(min(dum),1)
  b   <- max(dum)
  matplot(x=nset,y=dum,lty=1,xlab='$T$',ylim=c(a,b),lwd=1.5,type='b',col=1:lp1set,pch=16,ylab='$\\D_{\\text{init}}/\\D_{\\text{proj}}$');grid()
  axis(1,at=nset)
  legend('topleft',legend=pnames2[i+2],adj=0.5)
  abline(h=1,lty=3,col=2)
  legend('bottomright',col=1:lp1set,pch='',lwd=2,legend=paste0('$p_1 =$ ',p1set)) 
}
@
\end{center}

