load('../output/Section_B3.RData');
hnames2 <- c('$h_{R_0}$','$h_{C_0}$','$h_{R_1}$','$h_{C_1}$')
a <- min(percs)
par(mfrow=c(4,lp1set),omi=c(0.5,0.5,0.5,0),mai=c(0,0,0,0))
for(j in 1:4){
    for(k in 1:lp1set){
      p1 <- p1set[k]
     dum <- t(percs[k,j,,])
    boxplot(dum, ylab='', ylim=c(a,100),col='lightyellow',xaxt='n',yaxt='n')
    abline(h=0,col=2,lty=2);grid()
    if(k == 1)  axis(2)
